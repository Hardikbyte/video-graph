# Copy this file to .env and fill it in. Never commit .env.

# Connection string from MongoDB Atlas (Database > Connect). Keep the password out of git.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Signs login tokens. Use a long random value (at least 32 characters), for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<random-string-of-at-least-32-characters>

# Where the web app runs. Only these origins may call the API from a browser (comma separated).
CLIENT_ORIGIN=http://localhost:5173

# Set to true only when the server sits behind a reverse proxy (so rate limits see the real IP).
TRUST_PROXY=false

PORT=5000

# Used by the scripts (npm run seed, seed:boards, audit:boards, migrate:boards).
# Create this account by signing up in the app, or with: npm run seed
SEED_EMAIL=you@example.com
SEED_PASSWORD=<a-password-of-at-least-8-characters>
